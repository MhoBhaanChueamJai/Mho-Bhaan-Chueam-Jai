{
  "expo": {
    "name": "หมอบ้านเชื่อมใจ",
    "slug": "suebsan-folk-doctor-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E8B5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "th.bms.suebsan",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ใช้ไมโครโฟนเพื่อบันทึกเสียงเล่าอาการและภูมิปัญญา",
        "NSCameraUsageDescription": "ใช้กล้องเพื่อสแกนตำรายาและสมุดข่อย",
        "NSPhotoLibraryUsageDescription": "เลือกภาพตำรายาเพื่อแปลงเป็นดิจิทัล",
        "CFBundleDevelopmentRegion": "th",
        "CFBundleLocalizations": [
          "th"
        ],
        "CFBundleAllowMixedLocalizations": true
      },
      "appleTeamId": "FFFGJANVWN",
      "entitlements": {
        "com.apple.developer.default-data-protection": "NSFileProtectionComplete"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1F6B4A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ใช้กล้องเพื่อสแกนตำรายา สมุดข่อย และบัตรประชาชนผู้ป่วย",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ใช้ไมโครโฟนเพื่อบันทึกเสียงเล่าอาการและภูมิปัญญา"
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "cameraPermission": "ใช้กล้องเพื่อสแกนตำรายา สมุดข่อย และบัตรประชาชนผู้ป่วย"
        }
      ],
      "expo-router",
      "expo-asset",
      "./plugins/withPodDeploymentTarget",
      "./plugins/withSceneLifecycle",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ใช้ Face ID เพื่อเข้าสู่ระบบหมอบ้านเชื่อมใจอย่างรวดเร็ว"
        }
      ],
      "expo-video",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-sensors",
        {
          "motionPermission": "ใช้การเอียงเครื่องเพื่อแสดงแสงเงาบนบัตรผู้ป่วยแบบสามมิติ"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ใช้ตำแหน่งเพื่อดูสภาพอากาศบริเวณที่คุณหมออยู่ แล้วแนะนำสมุนไพรที่เหมาะกับอากาศวันนี้"
        }
      ],
      "./plugins/withPushEntitlement",
      [
        "expo-notifications",
        {
          "mode": "development"
        }
      ]
    ],
    "scheme": "suebsan",
    "experiments": {
      "baseUrl": "/Mho-Bhaan-Chueam-Jai"
    }
  }
}
